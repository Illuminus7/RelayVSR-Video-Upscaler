<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the bundled Python engine (only used with a Developer ID). -->
<plist version="1.0">
<dict>
    <!-- Python extension modules from PyPI are signed by us, but load each other freely. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- PyTorch and NumPy generate code at runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
